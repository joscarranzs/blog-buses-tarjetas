    </section>

    <section>
      <h2>Vocabulario de siglas</h2>
      <p>Significado de las siglas utilizadas en este blog y enlace a su definición.</p>
      <table>
        <thead>
          <tr><th>Sigla</th><th>Significado</th><th>Definición</th></tr>
        </thead>
        <tbody>
          <tr><td>ADC</td><td>Analog-to-Digital Converter (Convertidor Analógico-Digital)</td><td><a href="https://en.wikipedia.org/wiki/Analog-to-digital_converter" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>AD595</td><td>Analog Devices AD595 (amplificador para termopares)</td><td><a href="https://www.analog.com/en/products/ad595.html" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>AI</td><td>Analog Inputs (Entradas Analógicas)</td><td><a href="https://en.wikipedia.org/wiki/Data_acquisition" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>AO</td><td>Analog Outputs (Salidas Analógicas)</td><td><a href="https://en.wikipedia.org/wiki/Data_acquisition" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>API</td><td>Application Programming Interface (Interfaz de Programación de Aplicaciones)</td><td><a href="https://en.wikipedia.org/wiki/API" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>ATX</td><td>Advanced Technology Extended (factor de forma)</td><td><a href="https://en.wikipedia.org/wiki/ATX" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>CPU</td><td>Central Processing Unit (Unidad Central de Procesamiento)</td><td><a href="https://en.wikipedia.org/wiki/Central_processing_unit" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>CSV</td><td>Comma-Separated Values (Valores Separados por Comas)</td><td><a href="https://en.wikipedia.org/wiki/Comma-separated_values" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>DAQ</td><td>Data Acquisition (Adquisición de Datos)</td><td><a href="https://en.wikipedia.org/wiki/Data_acquisition" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>DDR4</td><td>Double Data Rate 4 (Memoria de Doble Tasa de Datos 4)</td><td><a href="https://en.wikipedia.org/wiki/DDR4_SDRAM" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>DIO</td><td>Digital Input/Output (Entradas/Salidas Digitales)</td><td><a href="https://en.wikipedia.org/wiki/Digital_signal" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>DMA</td><td>Direct Memory Access (Acceso Directo a Memoria)</td><td><a href="https://en.wikipedia.org/wiki/Direct_memory_access" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>GB</td><td>Gigabyte (Gigabytes)</td><td><a href="https://en.wikipedia.org/wiki/Gigabyte" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>GPU</td><td>Graphics Processing Unit (Unidad de Procesamiento Gráfico)</td><td><a href="https://en.wikipedia.org/wiki/Graphics_processing_unit" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>IRQ</td><td>Interrupt Request (Solicitud de Interrupción)</td><td><a href="https://en.wikipedia.org/wiki/Interrupt_request" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>MB</td><td>Megabyte (Megabytes)</td><td><a href="https://en.wikipedia.org/wiki/Megabyte" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>NI</td><td>National Instruments</td><td><a href="https://en.wikipedia.org/wiki/National_Instruments" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>NI-DAQmx</td><td>National Instruments Data Acquisition (driver)</td><td><a href="https://www.ni.com/docs/en-US/bundle/ni-daqmx/page/usermanual.html" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>NI MAX</td><td>Measurement &amp; Automation Explorer (National Instruments)</td><td><a href="https://www.ni.com/docs/en-US/bundle/measurement-automation-explorer/page/max.html" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>NVMe</td><td>Non-Volatile Memory Express (Memoria No Volátil Express)</td><td><a href="https://en.wikipedia.org/wiki/NVM_Express" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>PCI</td><td>Peripheral Component Interconnect (Interconexión de Componentes Periféricos)</td><td><a href="https://en.wikipedia.org/wiki/Peripheral_Component_Interconnect" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>PCIe</td><td>Peripheral Component Interconnect Express (Interconexión de Componentes Periféricos Express)</td><td><a href="https://en.wikipedia.org/wiki/PCI_Express" target="_blank" rel="noopener">Ver definición</a></td></tr>
