          <tr><td>RAM</td><td>Random Access Memory (Memoria de Acceso Aleatorio)</td><td><a href="https://en.wikipedia.org/wiki/Random-access_memory" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>RTD</td><td>Resistance Temperature Detector (Detector de Temperatura Resistivo)</td><td><a href="https://en.wikipedia.org/wiki/Resistance_thermometer" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>SCC</td><td>Signal Conditioning Component (módulos de acondicionamiento de señal)</td><td><a href="https://en.wikipedia.org/wiki/Signal_conditioning" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>SDK</td><td>Software Development Kit (Kit de Desarrollo de Software)</td><td><a href="https://en.wikipedia.org/wiki/Software_development_kit" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>SO</td><td>Operating System (Sistema Operativo)</td><td><a href="https://en.wikipedia.org/wiki/Operating_system" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>SSD</td><td>Solid State Drive (Unidad de Estado Sólido)</td><td><a href="https://en.wikipedia.org/wiki/Solid-state_drive" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>TB</td><td>Terabyte (Terabytes)</td><td><a href="https://en.wikipedia.org/wiki/Terabyte" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>USB</td><td>Universal Serial Bus (Bus Serie Universal)</td><td><a href="https://en.wikipedia.org/wiki/USB" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>VHDCI</td><td>Very High Density Cable Interconnect (Conector de Interfaz de Alta Densidad de Video)</td><td><a href="https://en.wikipedia.org/wiki/VHDCI" target="_blank" rel="noopener">Ver definición</a></td></tr>
          <tr><td>VIs</td><td>Virtual Instruments (Instrumentos Virtuales, LabVIEW)</td><td><a href="https://en.wikipedia.org/wiki/LabVIEW" target="_blank" rel="noopener">Ver definición</a></td></tr>
